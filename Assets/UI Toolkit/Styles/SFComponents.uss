/* This is the style sheet for commonly used custom SF Visual Elements and their related visual elements.
 * Make sure this style sheet is loaded after the common.uss style sheet. 
 * These are generally marked by the start of the class or selector name being sf-. */

/*TODO: 
    * Some selectors need name changes for the now standard naming for SF selector names.
    * See https://getbem.com/naming/ for the standard naming convention going forward. */

/* This style sheet follows the rule of selectors being declared in the following order.
 Custom Variables, Element selectors, id/name selectors, and finally class selectors. */

/* Start of the layout section. */
SideBarLayout {

}

SideBarLayout .side-bar{

}


.sf-container {
    min-width: 100%;
    min-height: 10%;
    width: 100%;
    height: 100%;
}

/* SF Row classes */
.sf-row {
    display: flex;
    flex-direction: row;
}

.sf-row.two-column > * {
    width: 50%;
}
/*  sf-row-item sets all children to take up the same flex baxis. 
    Making them all take the same size in the SF Row container as
    long as the content of one doesn't get to big for it's container.
    To prevent one from getting bigger due to it's content change the 
    auto to a set value for all of them.
    Example three buttons side by side with one having a bigger text label.
*/
.sf-row--item {
    flex:1 1 auto;
}

/* End of the layout section. */


/* Start of the not organized section. */
.sf-button-group {
    display: flex;
}

.sf__foldout .unity-foldout__text{
    font-size: 48px;
}

/* End of the not organized section. */

/* Start of the sf header class selectors. These are used in multiple SF custom elements.*/
.sf-header {
    display: flex;
    flex-direction: row;
    width: 100%;
}

.sf-header__header-container {
    height: 35px;
}

.sf-header__label--container {
    width: 20%;
    height: 50px;
    -unity-text-align: middle-center;
}

.sf-header__label {
    font-size: 18px;
    -unity-text-align: middle-left;
}

.sf-header__description {
    width: 80%;
}

/* End of the sf header class selectors. These are used in multiple SF custom elements.*/

.sf-menu-text {
    font-size: 25px;
    word-spacing: 24px;
    text-shadow: 2px 1px 4px black;
    -unity-font-style: Bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(126, 79, 37);
}

.sf-button__transparent {
    background-color: rgba(88, 88, 88, 0);
    height: 105px;
    width: 425px;
    font-size: 25px;
    -unity-font-style: bold;
    text-shadow: 2px 1px 4px rgb(0, 0, 0);
    -unity-text-align: middle-center;
    background-position-x: left -25px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}


